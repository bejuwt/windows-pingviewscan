<Window x:Class="PingViewScan.App.Views.AddHostsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Hosts" Height="440" Width="580"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#6b7280" Margin="0,0,0,8"
                   Text="Enter one host name or IP address per line, or paste a column straight from Excel." />

        <TextBox Grid.Row="1" x:Name="Input"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" />

        <CheckBox Grid.Row="2" x:Name="OnlyValid" Content="Only valid IP / hostnames"
                  IsChecked="True" Margin="0,10,0,0" />

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#6b7280" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Paste from Clipboard" Click="Paste_Click" Padding="10,3" />
                <Button Content="Cancel" Click="Cancel_Click" Margin="8,0,0,0" Padding="14,3" IsCancel="True" />
                <Button Content="Add" Click="Add_Click" Margin="8,0,0,0" Padding="14,3" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
