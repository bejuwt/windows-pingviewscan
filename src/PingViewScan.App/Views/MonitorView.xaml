<UserControl x:Class="PingViewScan.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PingViewScan.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <TextBox Width="220" VerticalAlignment="Center"
                     Text="{Binding NewHost, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Host name or IP address">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="Add" Command="{Binding AddCommand}" Margin="6,0,0,0" Padding="10,3" />
            <Button Content="Bulk Add…" Command="{Binding BulkAddCommand}" Margin="6,0,0,0" Padding="10,3" />
            <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="6,0,0,0" Padding="10,3" />
            <Button Content="Clear" Command="{Binding ClearCommand}" Margin="6,0,0,0" Padding="10,3" />

            <TextBlock Text="Interval (s)" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBox Width="46" VerticalAlignment="Center"
                     Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Timeout (s)" VerticalAlignment="Center" Margin="8,0,4,0" />
            <TextBox Width="46" VerticalAlignment="Center"
                     Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />

            <Button Content="{Binding RunningLabel}" Command="{Binding ToggleRunningCommand}"
                    Margin="12,0,0,0" Padding="16,3" MinWidth="72" Foreground="White">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#16a34a" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Background" Value="#dc2626" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Export HTML" Command="{Binding ExportHtmlCommand}" Margin="12,0,0,0" Padding="10,3" />
            <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="6,0,0,0" Padding="10,3" />
        </WrapPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding StatusText}" />
        </StatusBar>

        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="140" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="300" MinHeight="180" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="HostsGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding Hosts}"
                      SelectedItem="{Binding SelectedHost}"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      SelectionChanged="HostsGrid_SelectionChanged"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Host" Binding="{Binding Address}" SortMemberPath="Address" Width="180" />
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" SortMemberPath="Ip" Width="120" />
                    <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" SortMemberPath="Hostname" Width="200" />
                    <DataGridTextColumn Header="Sent" Binding="{Binding Stats.Sent}" SortMemberPath="Stats.Sent" Width="55" />
                    <DataGridTextColumn Header="Recv" Binding="{Binding Stats.Received}" SortMemberPath="Stats.Received" Width="55" />
                    <DataGridTextColumn Header="Lost" Binding="{Binding Stats.Lost}" SortMemberPath="Stats.Lost" Width="55" />
                    <DataGridTextColumn Header="Loss %" Binding="{Binding Stats.LossPercent, StringFormat={}{0:0.0}}" SortMemberPath="Stats.LossPercent" Width="70" />
                    <DataGridTextColumn Header="Last" Binding="{Binding Stats.Last, StringFormat={}{0:0.0}, TargetNullValue=—}" SortMemberPath="Stats.Last" Width="70" />
                    <DataGridTextColumn Header="Min" Binding="{Binding Stats.Min, StringFormat={}{0:0.0}, TargetNullValue=—}" SortMemberPath="Stats.Min" Width="70" />
                    <DataGridTextColumn Header="Max" Binding="{Binding Stats.Max, StringFormat={}{0:0.0}, TargetNullValue=—}" SortMemberPath="Stats.Max" Width="70" />
                    <DataGridTextColumn Header="Avg" Binding="{Binding Stats.Average, StringFormat={}{0:0.0}, TargetNullValue=—}" SortMemberPath="Stats.Average" Width="70" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                          Background="#e5e7eb" ResizeBehavior="PreviousAndNext" />

            <DockPanel Grid.Row="2">
                <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                    <TextBlock Text="Graph" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox Width="110" VerticalAlignment="Center"
                              ItemsSource="{Binding ChartModes}"
                              SelectedItem="{Binding ChartMode}" />

                    <TextBlock Text="Timeframe" VerticalAlignment="Center" Margin="12,0,4,0" />
                    <ComboBox Width="80" VerticalAlignment="Center"
                              ItemsSource="{Binding Timeframes}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedTimeframe}" />

                    <TextBlock Text="Hosts" VerticalAlignment="Center" Margin="12,0,4,0" />
                    <ComboBox Width="110" VerticalAlignment="Center"
                              ItemsSource="{Binding HostFilters}"
                              SelectedItem="{Binding HostFilter}" />

                    <TextBlock Text="Tip: select rows in the table (Ctrl/Shift-click) and choose “Selected” to graph only those hosts."
                               VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#6b7280" />
                </WrapPanel>

                <Border BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="6" Background="White" Padding="6">
                    <controls:LiveChart Hosts="{Binding Hosts}"
                                        SelectedIds="{Binding SelectedChartHostIds}"
                                        ShowSelectedOnly="{Binding ShowSelectedOnly}"
                                        Timeframe="{Binding SelectedTimeframe}"
                                        Mode="{Binding ChartMode}"
                                        Version="{Binding ChartVersion}" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
