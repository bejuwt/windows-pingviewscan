<UserControl x:Class="PingViewScan.App.Views.SubnetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="8,8,8,2" Foreground="#6b7280" TextWrapping="Wrap"
                   Text="Type an IPv4 address, optionally followed by a prefix length. Results update as you type." />

        <WrapPanel DockPanel.Dock="Top" Margin="8,4,8,8">
            <TextBlock Text="Address" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Width="240" VerticalAlignment="Center"
                     Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="e.g. 192.168.1.10/24" />
            <TextBlock Text="Prefix" VerticalAlignment="Center" Margin="10,0,4,0" />
            <ComboBox Width="70" VerticalAlignment="Center"
                      ItemsSource="{Binding Prefixes}"
                      SelectedItem="{Binding Prefix}" />
            <Button Content="Copy Summary" Command="{Binding CopyCommand}"
                    Margin="10,0,0,0" Padding="12,3" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                       Margin="12,0,0,0" Foreground="#6b7280" />
        </WrapPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding StatusText}" />
        </StatusBar>

        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  Margin="8,0,8,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Field" Binding="{Binding Label}" Width="170" />
                <DataGridTextColumn Header="Value" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
