<UserControl x:Class="PingViewScan.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <TextBlock Text="Targets" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Width="210" VerticalAlignment="Center"
                     Text="{Binding Targets, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="e.g. 10.0.0.0/24, 10.0.0.1-50, 10.0.0.*" />

            <TextBlock Text="Preset" VerticalAlignment="Center" Margin="8,0,4,0" />
            <ComboBox Width="150" VerticalAlignment="Center"
                      ItemsSource="{Binding Presets}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedPreset}" />

            <TextBlock Text="Ports" VerticalAlignment="Center" Margin="8,0,4,0" />
            <TextBox Width="210" VerticalAlignment="Center"
                     Text="{Binding PortsText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="e.g. 22,80,443,8000-8010" />

            <TextBlock Text="Ping (s)" VerticalAlignment="Center" Margin="8,0,4,0" />
            <TextBox Width="42" VerticalAlignment="Center" Text="{Binding PingTimeout, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Port (s)" VerticalAlignment="Center" Margin="8,0,4,0" />
            <TextBox Width="42" VerticalAlignment="Center" Text="{Binding PortTimeout, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Concurrency" VerticalAlignment="Center" Margin="8,0,4,0" />
            <TextBox Width="46" VerticalAlignment="Center" Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}" />

            <Button Content="Scan" Command="{Binding StartCommand}" Margin="12,0,0,0" Padding="16,3"
                    MinWidth="72" Foreground="White">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2563eb" />
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Stop" Command="{Binding StopCommand}" Margin="6,0,0,0" Padding="16,3" MinWidth="72" />
            <Button Content="Export HTML" Command="{Binding ExportHtmlCommand}" Margin="12,0,0,0" Padding="10,3" />
            <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="6,0,0,0" Padding="10,3" />
        </WrapPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding StatusText}" />
        </StatusBar>

        <DataGrid ItemsSource="{Binding Results}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  Margin="8,0,8,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="IP address" Binding="{Binding Ip}" Width="140" />
                <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="240" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="110" />
                <DataGridTextColumn Header="Ping (ms)" Binding="{Binding PingMs, StringFormat={}{0:0.0}, TargetNullValue=—}" Width="90" />
                <DataGridTextColumn Header="Open ports" Binding="{Binding OpenPortsText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
